import streamlit as st
import pandas as pd

st.title("📋 Rekap Kehadiran Hari Ini")

if st.session_state.daftar_absensi:
    df = pd.DataFrame(st.session_state.daftar_absensi)
    st.dataframe(df, use_container_width=True)
    
    if st.button("Reset Data Presensi"):
        st.session_state.daftar_absensi = []
        st.rerun()
else:
    st.write("Belum ada mahasiswa yang melakukan presensi.")
