import streamlit as st

st.title("📝 Form Presensi Mahasiswa")

nama = st.text_input("Nama Lengkap:")
nim = st.text_input("NIM:")
status = st.radio("Status Kehadiran:", ["Hadir", "Izin", "Sakit"])

if st.button("Kirim Presensi"):
    if nama.strip() and nim.strip():
        st.session_state.daftar_absensi.append({
            "NIM": nim,
            "Nama": nama,
            "Status": status
        })
        st.success("Presensi berhasil dicatat!")
    else:
        st.warning("Lengkapi Nama dan NIM terlebih dahulu.")

